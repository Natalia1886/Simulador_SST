{
  "name": "simulsst-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo SimulSST Pro - Sistema Simulador de Seguridad y Salud en el Trabajo",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build:css": "tailwindcss -i apps/web/src/input.css -o apps/web/public/output.css",
    "watch:css": "tailwindcss -i apps/web/src/input.css -o apps/web/public/output.css --watch",
    "dev:api": "npm --prefix apps/api run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "dev": "npx --yes concurrently -k -n \"api,web\" -c \"blue,green\" \"npm run dev:api\" \"npm run dev:web\""
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.3.5"
  }
}
