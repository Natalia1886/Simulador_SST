# Configuración de Servidor
PORT=4000
NODE_ENV=development

# Base de datos PostgreSQL
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/simulsst_db

# Seguridad y Autenticación
JWT_SECRET=
COOKIE_SECURE=false
TEACHER_REGISTRATION_CODE=

# Cloudinary (Opcional - solo para logos de empresas)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
